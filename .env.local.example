# ============================================================================
# Patient Cost Clarity — Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.local.example .env.local
# ============================================================================

# ----------------------------------------------------------------------------
# App Mode
# ----------------------------------------------------------------------------
# Controls the default data source and whether login is required.
#
#   mock       — Uses local fixture data. No API keys or login needed.
#                Best for local development and exploring the UI.
#
#   sandbox    — Calls real Optum sandbox + AI APIs. Requires the
#                credentials below AND authentication (see Auth section).
#
#   production — Calls production Optum API with real member data.
#                Requires a production Optum developer account + auth.
#
# TIP: Start with mock mode. You can switch to sandbox at runtime using
# the toggle in the app header — no restart needed.
NEXT_PUBLIC_APP_ENV=mock

# ----------------------------------------------------------------------------
# Azure Backend Service (Docker / Azure deployment)
# ----------------------------------------------------------------------------
# URL of the Python Semantic Kernel backend. Set when running via
# docker-compose or Azure Container Apps. Leave unset on Vercel to use
# the built-in Claude interpreter as fallback.
BACKEND_URL=http://localhost:8000

# Set to "true" to route AI interpretation to the Azure backend instead
# of the built-in Anthropic Claude call. Leave unset on Vercel.
# NEXT_PUBLIC_FORCE_BACKEND=true

# ----------------------------------------------------------------------------
# Optum API — Sandbox Credentials (sandbox/production only)
# ----------------------------------------------------------------------------
# Obtain by registering at: https://marketplace.optum.com/apiservices/api-sandbox-access
# Not needed in mock mode.
OPTUM_CLIENT_ID=
OPTUM_CLIENT_SECRET=
OPTUM_AUTH_URL=https://idx.linkhealth.com/auth/realms/developer-platform/protocol/openid-connect/token
OPTUM_ELIGIBILITY_URL=https://sandbox-apigw.optum.com/oihub/eligibility/v1/pre-service/member
OPTUM_PROVIDER_TAX_ID=

# ----------------------------------------------------------------------------
# Authentication (sandbox/production only)
# ----------------------------------------------------------------------------
# Mock mode has NO login — just run `bun dev` and go.
# Sandbox and production modes require a username/password to protect
# API credentials from unauthorized use.
#
# Quick start with demo credentials:
#   AUTH_USERNAME=demo
#   AUTH_PASSWORD_HASH=<generate with script below>
#   AUTH_SECRET=<generate with script below>
#
# To generate AUTH_PASSWORD_HASH and AUTH_SECRET, run:
#   node scripts/generate-password-hash.mjs
#
# The script will prompt you for a password and output the two values.
# Paste them here and set AUTH_USERNAME to your chosen username.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SECRET=
